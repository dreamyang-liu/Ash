  {
   "id": "riskt",
   "type": "text",
   "x": 856,
   "y": 632,
   "width": 115,
   "height": 18,
   "angle": 0,
   "strokeColor": "#ffd43b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "roundness": null,
   "seed": 44,
   "version": 1,
   "isDeleted": false,
   "text": "要你拍板的两处",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "要你拍板的两处",
   "lineHeight": 1.25,
   "boundElements": [],
   "link": null,
   "locked": false,
   "autoResize": true
  },
  {
   "id": "riskx",
   "type": "text",
   "x": 856,
   "y": 660,
   "width": 497,
   "height": 150,
   "angle": 0,
   "strokeColor": "#a0a0a0",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "roundness": null,
   "seed": 45,
   "version": 1,
   "isDeleted": false,
   "text": "① 默认 manifest 给什么工具？\n   保守：mcp_exec.yaml 精确复刻现在这 4 个 → 行为零变化，数字可比\n   激进：顺手把 web_fetch / web_search 加上 → 更合理，但之前的评测数字作废\n   （我倾向保守，网络能力单独开一个 manifest 供需要时用）\n\n② 第一步那次搬迁要不要先跳过？\n   可以先只做第二步的一半：MCP server 里直接调 SDK 的 compile_panel，\n   手工读 YAML，确认编译产物能替换字面量、行为一致，\n   再决定要不要动 AshAgent 那边的代码。\n   好处：万一编译路径有没预料到的问题，AshAgent 一行没动。",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "① 默认 manifest 给什么工具？\n   保守：mcp_exec.yaml 精确复刻现在这 4 个 → 行为零变化，数字可比\n   激进：顺手把 web_fetch / web_search 加上 → 更合理，但之前的评测数字作废\n   （我倾向保守，网络能力单独开一个 manifest 供需要时用）\n\n② 第一步那次搬迁要不要先跳过？\n   可以先只做第二步的一半：MCP server 里直接调 SDK 的 compile_panel，\n   手工读 YAML，确认编译产物能替换字面量、行为一致，\n   再决定要不要动 AshAgent 那边的代码。\n   好处：万一编译路径有没预料到的问题，AshAgent 一行没动。",
   "lineHeight": 1.25,
   "boundElements": [],
   "link": null,
   "locked": false,
   "autoResize": true
  }
